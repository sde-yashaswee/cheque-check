{
  "name": "cheque-check",
  "version": "0.1.1",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "format": "node scripts/check-format.mjs --write",
    "format:check": "node scripts/check-format.mjs",
    "prepare": "husky",
    "admin:monetization": "tsx scripts/admin-monetization.ts",
    "storage:migrate": "tsx scripts/migrate-private-storage.ts",
    "supabase:setup": "tsx scripts/supabase-setup.ts",
    "supabase:reset": "tsx scripts/supabase-reset.ts",
    "supabase:gen-types": "supabase gen types typescript --linked --schema public > src/types/database.types.ts",
    "supabase:gen-types:local": "supabase gen types typescript --local --schema public > src/types/database.types.ts",
    "supabase:functions:deploy": "supabase functions deploy send-reminders && supabase functions deploy razorpay-webhook"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.32",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/nprogress": "^0.2.3",
    "ai": "^7.0.55",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "glob": "^13.0.6",
    "next": "16.3.6",
    "next-intl": "^4.13.5",
    "nprogress": "^0.2.0",
    "pino": "^10.3.1",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "react-photo-view": "^1.2.7",
    "react-speech-recognition": "^4.0.1",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.10.1",
    "regenerator-runtime": "^0.14.1",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-speech-recognition": "^3.9.6",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^17.4.2",
    "enquirer": "^2.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
