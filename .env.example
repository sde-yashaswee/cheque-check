# Core application configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_LOG_LEVEL=debug

# AI cheque scanning
OPENAI_API_KEY=

# Razorpay payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Administrative scripts and Supabase Edge Functions
SUPABASE_SERVICE_ROLE_KEY=

# QA e2e only (scripts/run-e2e-qa.ts): direct Postgres connection string used to
# fully reset (migrate + seed) the QA Supabase project before each e2e run.
# Get it from Project Settings -> Database -> Connection string (Session pooler
# recommended for IPv4 compatibility in CI).
SUPABASE_DB_URL=

# Sentry source map uploads
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# WhatsApp support contact link (defaults to +91 9794457099 if unset)
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=+919794457099
